# ==============================================================
# AI-Powered Customer Support & Service Automation
# Environment Variables Configuration
# ==============================================================

# Google Gemini API Key (Optional: for AI response generation & classification)
# If omitted, the system gracefully operates on built-in rule-based intelligence
GOOGLE_API_KEY=

# Flask Application Secret Key (Change this in production)
FLASK_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key

# Flask Environment (development | production)
FLASK_ENV=production
FLASK_DEBUG=false

# Admin Dashboard Credentials
ADMIN_USER=admin
ADMIN_PASS=admin123

# Server Port (Default: 5000)
PORT=5000
